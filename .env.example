# Dollax Panel — environment variables
# Local: copy this file to `.env` and edit it.
# Railway: add the same keys under your service → Variables (see README).

# The owner account, created on first boot only (change the password after login).
ADMIN_USERNAME=dollax26
ADMIN_PASSWORD=***

# Optional. Signs the session cookie. If it is EMPTY the app generates a random
# one at every boot, which means everyone gets logged out on each restart.
# Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
SECRET_KEY=

*** The public URL clients will use (your Railway domain or a custom domain).
# Used to build every generated config and subscription link. No port needed (443).
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Which port the panel LISTENS on (inside the container).
# Railway injects $PORT itself (8080 by convention) — leave this commented unless
# you changed the service's public-networking target port. Local default: 8080.
# PORT=8080

# Where dollax.db lives.
# Leave this line COMMENTED OUT locally (it defaults to ./data).
# On Railway: mount a Volume at /data and then uncomment/set DATA_DIR=/data.
# DATA_DIR=/data

# Optional: uvicorn log level (info, warning, error).
# LOG_LEVEL=info
